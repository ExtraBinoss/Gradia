{
  "name": "gradia-studio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run prepare:assets && vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "build": "bun run typecheck && bun run build:package && bun run prepare:assets && vite build --config apps/web/vite.config.ts && bun run build:lib && python3 scripts/package-kit.py",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/core/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "oxlint . && eslint . --max-warnings 0",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run test:coverage && bun run build",
    "build:package": "bun scripts/build-package.ts",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "prepare:assets": "python3 scripts/prepare-assets.py",
    "assets:social": "bun scripts/render-social.ts",
    "test:package": "bun scripts/check-package.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@plinka/gradient-core": "workspace:*",
    "@plinka/gradient-react": "workspace:*",
    "@plinka/gradient-webgl": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "i18next": "^26.5.2",
    "jotai": "^2.15.0",
    "lucide-react": "^1.58.0",
    "mediabunny": "^1.62.1",
    "motion": "^14.3.0",
    "react": "19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.0",
    "shadcn": "^4.22.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsonc-parser": "^3.3.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "8.3.4",
    "vitest": "^4.0.0",
    "wrangler": "4.151.1"
  },
  "packageManager": "bun@1.4.2"
}
